      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_banner" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;arcSize=4;align=left;spacingLeft=20;" value="&lt;b style=&quot;font-size: 18px; color: #1E293B;&quot;&gt;Oracle Cloud Infrastructure (OCI) Web Architecture&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 12px; color: #64748B;&quot;&gt;Region: Japan East (Tokyo) [ap-tokyo-1] | Compartment: codyssey-compartment | Public Web Service with Nginx&lt;/span&gt;" vertex="1">
