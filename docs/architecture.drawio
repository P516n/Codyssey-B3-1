        </mxCell>
        <mxCell id="route_table" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=11;align=center;" value="&lt;b&gt;Default Route Table&lt;/b&gt;&lt;hr style=&quot;margin: 2px;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;0.0.0.0/0 ➔ codyssey-igw&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="160" x="460" y="225" as="geometry" />
        </mxCell>
        <mxCell id="security_list" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontSize=11;align=center;" value="&lt;b&gt;Default Security List (Ingress Rules)&lt;/b&gt;&lt;hr style=&quot;margin: 2px;&quot;&gt;&lt;div style=&quot;text-align: left; font-size: 10px; line-height: 1.4;&quot;&gt;• &lt;b&gt;TCP 80 (HTTP):&lt;/b&gt; Source 0.0.0.0/0 (Stateful)&lt;br&gt;• &lt;b&gt;TCP 22 (SSH):&lt;/b&gt; Source &amp;lt;Admin IP&amp;gt;/32&lt;br&gt;• &lt;b&gt;Egress All:&lt;/b&gt; 0.0.0.0/0&lt;/div&gt;" vertex="1">
          <mxGeometry height="65" width="410" x="650" y="220" as="geometry" />
        </mxCell>
        <mxCell id="subnet_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=12;" value="&lt;b style=&quot;color: #0284C7;&quot;&gt;Public Subnet:&lt;/b&gt; codyssey-public-subnet (10.0.1.0/24) [Public Access Enabled]" vertex="1">
          <mxGeometry height="425" width="600" x="460" y="315" as="geometry" />
        </mxCell>
        <mxCell id="instance_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=11;" value="&lt;b&gt;Compute Instance:&lt;/b&gt; codyssey-web-server &lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;(Shape: VM.Standard.E2.1.Micro Always Free)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #2563EB;&quot;&gt;Public IPv4: &amp;lt;Public-IP&amp;gt;&lt;/span&gt; | &lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;Private IP: 10.0.1.97&lt;/span&gt; | &lt;span style=&quot;font-size: 10px; color: #16A34A;&quot;&gt;OS: Ubuntu 22.04 LTS&lt;/span&gt;" vertex="1">
          <mxGeometry height="355" width="540" x="490" y="365" as="geometry" />
        </mxCell>
        <mxCell id="iptables_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=10;align=center;" value="&lt;b&gt;OS Firewall (iptables)&lt;/b&gt;&lt;hr style=&quot;margin: 2px;&quot;&gt;&lt;div style=&quot;text-align: left; font-size: 10px; line-height: 1.4;&quot;&gt;&lt;span style=&quot;color: #16A34A; font-weight: bold;&quot;&gt;1. ACCEPT TCP 80&lt;/span&gt; (Top Rule)&lt;br&gt;2. ACCEPT TCP 22 (SSH)&lt;br&gt;3. ACCEPT RELATED,ESTABLISHED&lt;br&gt;&lt;span style=&quot;color: #DC2626; font-weight: bold;&quot;&gt;4. REJECT ALL (Default)&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="180" x="515" y="445" as="geometry" />
        </mxCell>
        <mxCell id="nginx_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#009639;strokeColor=#006827;fontColor=#FFFFFF;fontSize=11;align=center;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Nginx Web Server&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Listening on &lt;b&gt;0.0.0.0:80&lt;/b&gt;&lt;/span&gt;&lt;hr style=&quot;margin: 4px;&quot;&gt;&lt;div style=&quot;text-align: left; font-size: 10px; line-height: 1.5;&quot;&gt;• &lt;b&gt;GET /&lt;/b&gt; ➔ 200 OK (&quot;Welcome to nginx!&quot;)&lt;br&gt;• &lt;b&gt;GET /health&lt;/b&gt; ➔ 200 OK (&quot;OK&quot;)&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="260" x="740" y="440" as="geometry" />
        </mxCell>
