          <mxGeometry height="65" width="120" x="280" y="235" as="geometry" />
        </mxCell>
        <mxCell id="vcn_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F0F7FF;strokeColor=#1E3A8A;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=12;" value="&lt;b style=&quot;color: #1E3A8A;&quot;&gt;Virtual Cloud Network (VCN):&lt;/b&gt; codyssey-vcn (10.0.0.0/16)" vertex="1">
